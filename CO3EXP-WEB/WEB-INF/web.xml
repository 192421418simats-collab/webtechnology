<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

  <display-name>CO3EXP-WEB Experiments Suite</display-name>

  <!-- Experiment 6 Servlet -->
  <servlet>
    <servlet-name>Exp6DynamicServlet</servlet-name>
    <servlet-class>com.university.servlet.Exp6DynamicServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>Exp6DynamicServlet</servlet-name>
    <url-pattern>/Exp6DynamicServlet</url-pattern>
  </servlet-mapping>

  <!-- Experiment 7 Servlet -->
  <servlet>
    <servlet-name>Exp7FormServlet</servlet-name>
    <servlet-class>com.university.servlet.Exp7FormServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>Exp7FormServlet</servlet-name>
    <url-pattern>/Exp7FormServlet</url-pattern>
  </servlet-mapping>

  <!-- Experiment 8 Servlet -->
  <servlet>
    <servlet-name>Exp8ResultServlet</servlet-name>
    <servlet-class>com.university.servlet.Exp8ResultServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>Exp8ResultServlet</servlet-name>
    <url-pattern>/Exp8ResultServlet</url-pattern>
  </servlet-mapping>

  <!-- Experiment 9 Servlet -->
  <servlet>
    <servlet-name>Exp9LifecycleServlet</servlet-name>
    <servlet-class>com.university.servlet.Exp9LifecycleServlet</servlet-class>
    <load-on-startup>1</load-on-startup>
  </servlet>
  <servlet-mapping>
    <servlet-name>Exp9LifecycleServlet</servlet-name>
    <url-pattern>/Exp9LifecycleServlet</url-pattern>
  </servlet-mapping>

  <!-- Experiment 10 Servlet -->
  <servlet>
    <servlet-name>Exp10ConcurrencyServlet</servlet-name>
    <servlet-class>com.university.servlet.Exp10ConcurrencyServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>Exp10ConcurrencyServlet</servlet-name>
    <url-pattern>/Exp10ConcurrencyServlet</url-pattern>
  </servlet-mapping>

  <welcome-file-list>
    <welcome-file>index.html</welcome-file>
  </welcome-file-list>
</web-app>
